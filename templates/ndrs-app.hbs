<div class="ndrs-app-container">

    <header class="ndrs-topbar">
        <div class="ndrs-topbar-row">
            <div class="ndrs-logo">D&amp;D 5.5 <span>{{localize "NDRS.Subtitle"}}</span></div>
            <div class="ndrs-search">
                <i class="fas fa-search ndrs-search-icon" aria-hidden="true"></i>
                <input type="search" id="ndrs-search-input" autocomplete="off"
                       placeholder="{{localize "NDRS.UI.SearchPlaceholder"}}"
                       aria-label="{{localize "NDRS.UI.SearchPlaceholder"}}" />
                {{#if search}}
                <button type="button" class="ndrs-search-clear" data-action="clearSearch"
                        title="{{localize 'NDRS.UI.SearchClear'}}"
                        aria-label="{{localize 'NDRS.UI.SearchClear'}}">
                    <i class="fas fa-times" aria-hidden="true"></i>
                </button>
                {{/if}}
            </div>
        </div>
        <nav class="ndrs-tabs" aria-label="{{localize "NDRS.AppTitle"}}">
            {{#each tabs}}
            <button type="button"
                    class="ndrs-tab-btn {{#if active}}active{{/if}}"
                    data-action="selectTab" data-tab="{{id}}"
                    aria-pressed="{{#if active}}true{{else}}false{{/if}}">
                <i class="fas {{iconClass}}" aria-hidden="true"></i>{{label}}
            </button>
            {{/each}}
        </nav>
    </header>

    <main class="ndrs-content">
        {{#if searching}}
        <p class="ndrs-search-scope">
            <i class="fas fa-magnifying-glass" aria-hidden="true"></i>
            {{localize "NDRS.UI.SearchAllTabs"}}
        </p>
        {{/if}}

        {{#if noResults}}
        <div class="ndrs-empty">{{localize "NDRS.UI.Empty"}}</div>
        {{/if}}

        {{#each sections}}
            <section class="ndrs-section">
                <h2 class="ndrs-section-header">{{localize titleKey}}</h2>

                {{#if custom}}
                    {{#if (eq custom "exhaustion")}}
                        <p class="ndrs-exh-intro">{{data.intro}}</p>
                        <table class="ndrs-exh-table">
                            <thead>
                                <tr>
                                    <th scope="col">{{localize "NDRS.UI.ExhaustionLevel"}}</th>
                                    <th scope="col">{{localize "NDRS.UI.ExhaustionEffect"}}</th>
                                </tr>
                            </thead>
                            <tbody>
                                {{#each data.levels}}
                                <tr>
                                    <td>
                                        <span class="ndrs-exh-level-badge {{#if isDeath}}is-death{{/if}}">{{level}}</span>
                                    </td>
                                    <td>{{desc}}</td>
                                </tr>
                                {{/each}}
                            </tbody>
                        </table>
                        <p class="ndrs-exh-notes">{{data.notes}}</p>
                    {{/if}}

                    {{#if (eq custom "calendar")}}
                        <div class="ndrs-calendar-intro">{{data.intro}}</div>

                        <div class="ndrs-calendar-timeline">
                            {{#each data.timeline}}
                                {{#if (eq type "month")}}
                                    <div class="ndrs-calendar-month">
                                        <div class="ndrs-calendar-month-name">
                                            {{name}}{{#if subtitle}}<span class="ndrs-calendar-month-sub">{{subtitle}}</span>{{/if}}
                                        </div>
                                        <div class="ndrs-calendar-month-grid">
                                            {{#each grid}}
                                                <div class="ndrs-tenday-col">
                                                    <div class="ndrs-tenday-label">{{label}}</div>
                                                    {{#each days}}
                                                        <div class="ndrs-day-cell {{#if isTenday}}is-tenday{{/if}}">{{day}}</div>
                                                    {{/each}}
                                                </div>
                                            {{/each}}
                                        </div>
                                    </div>
                                {{else}}
                                    <div class="ndrs-calendar-holiday {{#if leap}}ndrs-calendar-leap{{/if}}">
                                        <span class="ndrs-calendar-holiday-name">
                                            <i class="fas fa-star" aria-hidden="true"></i> {{name}}
                                            {{#if leap}}<span class="ndrs-calendar-leap-meta">· {{localize "NDRS.UI.CalendarLeap"}} ({{everyYears}})</span>{{/if}}
                                        </span>
                                        <span class="ndrs-calendar-holiday-desc">{{desc}}</span>
                                    </div>
                                {{/if}}
                            {{/each}}
                        </div>
                    {{/if}}
                {{else}}
                    {{#if cards.length}}
                        <div class="ndrs-grid">
                            {{#each cards}}
                            <div class="ndrs-card {{#if isFavorite}}is-favorite{{/if}}"
                                 data-action="openCard" data-card-id="{{id}}"
                                 role="button" tabindex="0"
                                 aria-label="{{title}}">
                                <div class="ndrs-card-header">
                                    <i class="fas {{icon}} ndrs-card-icon" aria-hidden="true"></i>
                                    <div class="ndrs-card-title">{{title}}</div>
                                    <button type="button" class="ndrs-card-fav"
                                            data-action="toggleFav" data-card-id="{{id}}"
                                            aria-pressed="{{#if isFavorite}}true{{else}}false{{/if}}"
                                            title="{{#if isFavorite}}{{localize 'NDRS.UI.FavoriteRemove'}}{{else}}{{localize 'NDRS.UI.Favorite'}}{{/if}}"
                                            aria-label="{{#if isFavorite}}{{localize 'NDRS.UI.FavoriteRemove'}}{{else}}{{localize 'NDRS.UI.Favorite'}}{{/if}}">
                                        <i class="fas fa-star" aria-hidden="true"></i>
                                    </button>
                                </div>
                                <div class="ndrs-card-subtitle">{{subtitle}}</div>
                            </div>
                            {{/each}}
                        </div>
                    {{else}}
                        <div class="ndrs-empty">{{localize "NDRS.UI.Empty"}}</div>
                    {{/if}}
                {{/if}}
            </section>
        {{/each}}
    </main>

    <footer class="ndrs-footer">
        <span>{{localize "NDRS.Footer.Version"}} {{version}}</span>
        <span class="sep" aria-hidden="true">•</span>
        <span>{{localize "NDRS.Footer.By"}}</span>
        <span class="sep" aria-hidden="true">•</span>
        <div class="ndrs-unit-toggle" role="group" aria-label="{{localize 'NDRS.UI.UnitsLabel'}}">
            <button type="button"
                    class="ndrs-unit-seg {{#if isMetric}}active{{/if}}"
                    data-action="setUnits" data-unit="metric"
                    aria-pressed="{{#if isMetric}}true{{else}}false{{/if}}"
                    title="{{localize 'NDRS.Settings.DefaultUnits.Metric'}}">
                {{localize "NDRS.Units.Metric"}}
            </button>
            <button type="button"
                    class="ndrs-unit-seg {{#unless isMetric}}active{{/unless}}"
                    data-action="setUnits" data-unit="imperial"
                    aria-pressed="{{#unless isMetric}}true{{else}}false{{/unless}}"
                    title="{{localize 'NDRS.Settings.DefaultUnits.Imperial'}}">
                {{localize "NDRS.Units.Imperial"}}
            </button>
        </div>
    </footer>

    {{#if hasOpenCard}}
    <div class="ndrs-modal-overlay" data-action="closeModalBackdrop">
        <div class="ndrs-modal" role="dialog" aria-modal="true" aria-labelledby="ndrs-modal-title">
            <header class="ndrs-modal-header">
                <h2 class="ndrs-modal-title" id="ndrs-modal-title">
                    <i class="fas {{openCard.icon}}" aria-hidden="true"></i> {{openCard.title}}
                </h2>
                <div class="ndrs-modal-subtitle">{{openCard.subtitle}}</div>
                <button type="button" class="ndrs-modal-close" data-action="closeModal"
                        title="{{localize 'NDRS.UI.ModalClose'}}"
                        aria-label="{{localize 'NDRS.UI.ModalClose'}}">&times;</button>
            </header>
            <div class="ndrs-modal-body">
                {{#if openCard.summary}}
                <div class="ndrs-modal-section">
                    <h3>{{localize "NDRS.UI.ModalSummary"}}</h3>
                    <div>{{openCard.summary}}</div>
                </div>
                {{/if}}
                {{#if openCard.example}}
                <div class="ndrs-modal-section">
                    <h3>{{localize "NDRS.UI.ModalExample"}}</h3>
                    <div>{{openCard.example}}</div>
                </div>
                {{/if}}
                {{#if openCard.hasNotes}}
                <div class="ndrs-modal-section">
                    <h3>{{localize "NDRS.UI.ModalNotes"}}</h3>
                    <div>{{openCard.notes}}</div>
                </div>
                {{/if}}
            </div>
            <footer class="ndrs-modal-footer">
                <span>
                    {{localize "NDRS.UI.ModalSource"}}: <strong>{{openCard.source.book}}</strong>
                    {{#if openCard.source.page}} · {{localize "NDRS.UI.ModalPage"}} {{openCard.source.page}}{{/if}}
                </span>
                {{#if openCard.phbLink}}
                <button type="button" class="ndrs-phb-btn"
                        data-action="openPhb" data-uuid="{{openCard.phbLink.uuid}}"
                        title="{{openCard.phbLink.label}}">
                    <i class="fas fa-book-open" aria-hidden="true"></i> {{localize "NDRS.UI.OpenInPhb"}}
                </button>
                {{/if}}
            </footer>
        </div>
    </div>
    {{/if}}

</div>
